# Environment variables for Projetta2 React Frontend

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Application Configuration
VITE_APP_NAME="Projetta2 Dashboard"
VITE_APP_VERSION="2.0.0"
VITE_APP_DESCRIPTION="Dashboard de Análise de Propostas de Crédito"

# Features Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true

# Theme Configuration
VITE_PRIMARY_COLOR="#3b82f6"
VITE_SUCCESS_COLOR="#10b981"
VITE_WARNING_COLOR="#f59e0b"
VITE_ERROR_COLOR="#ef4444"

# Development Configuration
VITE_DEV_MODE=true
VITE_MOCK_DATA=true
VITE_ENABLE_DEBUG=true

# Export Configuration
VITE_DEFAULT_EXPORT_FORMAT=excel
VITE_MAX_EXPORT_RECORDS=100000

# Cache Configuration
VITE_CACHE_TTL=300000
VITE_CACHE_ENABLED=true

# Performance Configuration
VITE_LAZY_LOAD_CHARTS=true
VITE_VIRTUALIZATION_THRESHOLD=1000
